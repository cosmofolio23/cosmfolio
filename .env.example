# ==============================================================
# CosmoFolio Environment Configuration
# Phase 7: Task 7.5 — Copy to .env and fill in real values
# NEVER commit the actual .env file to version control
# ==============================================================

# ==================== APPLICATION ====================
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # false in production
LOG_LEVEL=debug                  # debug | info | warning | error
APP_VERSION=1.0.0
SECRET_KEY=replace_with_64_char_random_string_here_use_openssl_rand

# ==================== DATABASE ====================
DATABASE_URL=postgresql://cosmofolio:change_me@postgres:5432/cosmofolio
DB_PASSWORD=change_me            # Used by docker-compose
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ==================== REDIS ====================
REDIS_URL=redis://:change_me@redis:6379/0
REDIS_PASSWORD=change_me         # Used by docker-compose

# ==================== API KEYS ====================
REPLICATE_API_TOKEN=r8_your_replicate_token_here
# OPENAI_API_KEY=sk-your_openai_key_here    # Optional alternative LLM

# ==================== STORAGE ====================
# Supabase Storage (primary)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AWS S3 (for backups)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=cosmofolio-backups
S3_ASSETS_BUCKET=cosmofolio-assets

# ==================== SECURITY ====================
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURE_COOKIES=false             # true in production (requires HTTPS)

# ==================== MONITORING ====================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
# DATADOG_API_KEY=your_datadog_key
# NEW_RELIC_LICENSE_KEY=your_nr_key

# ==================== NOTIFICATIONS ====================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
NOTIFY_EMAIL=ops@cosmofolio.com

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn

# ==================== VERCEL (frontend deployment) ====================
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_vercel_org
# VERCEL_PROJECT_ID=your_vercel_project

# ==================== AWS (backend deployment) ====================
# AWS_ECS_CLUSTER=cosmofolio-prod
# AWS_ECS_SERVICE=cosmofolio-api
# CF_DISTRIBUTION_ID=your_cloudfront_distribution

# ==================== CLOUDFLARE (CDN) ====================
# CLOUDFLARE_ZONE_ID=your_zone_id
# CLOUDFLARE_API_TOKEN=your_api_token
