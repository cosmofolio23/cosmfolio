  });

});

// ==================== ACCESSIBILITY TESTS ====================

test.describe('Accessibility', () => {

  test('Navigation is keyboard accessible', async ({ page }) => {
    await login(page);

    // Tab through navigation
    await page.press('body', 'Tab');
    await page.press('body', 'Tab');

    // Should be able to focus on menu items
    const focused = await page.evaluate(() => document.activeElement?.tagName);
    expect(['A', 'BUTTON', 'INPUT']).toContain(focused);
  });

  test('Modal has proper ARIA attributes', async ({ page }) => {
    await login(page);
    await createPortfolio(page);

    await page.click('button:has-text("Share")');

    // Modal should have role
    expect(await page.getAttribute('[role="dialog"]', 'role')).toBe('dialog');

    // Close button should be accessible
    expect(await page.isVisible('button[aria-label="Close"]')).toBeTruthy();
  });

});

// ==================== ERROR SCENARIOS ====================

test.describe('Error Handling', () => {

  test('Shows error when network fails', async ({ page }) => {
    // Simulate network offline
    await page.context().setOffline(true);

    await page.goto(`${BASE_URL}/dashboard`).catch(() => {});

    // Should show offline message
    expect(await page.isVisible('text=Offline')).toBeTruthy();
  });

  test('Handles API errors gracefully', async ({ page }) => {
    await login(page);

    // Intercept API and return error
    await page.route('**/api/portfolios', (route) => {
      route.abort('failed');
    });

    await page.goto(`${BASE_URL}/dashboard`);

    // Should show error message
    expect(await page.isVisible('text=Failed to load')).toBeTruthy();
  });

});
