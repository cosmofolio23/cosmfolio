"""
End-to-End Tests
Phase 7: Task 7.2 - Complete user journey testing with Cypress/Playwright
"""

import { test, expect, Page } from '@playwright/test';

// ==================== FIXTURES ====================

const BASE_URL = 'http://localhost:3000';
const TEST_USER = {
  email: 'test@example.com',
  password: 'Test123!@#',
  name: 'Test User',
};

// ==================== HELPER FUNCTIONS ====================

async function login(page: Page) {
  await page.goto(`${BASE_URL}/auth/login`);
  await page.fill('input[type="email"]', TEST_USER.email);
  await page.fill('input[type="password"]', TEST_USER.password);
  await page.click('button:has-text("Sign In")');
  await page.waitForNavigation();
  expect(page.url()).toContain('/dashboard');
}

async function createPortfolio(page: Page) {
  await page.goto(`${BASE_URL}/dashboard`);
  await page.click('button:has-text("New Portfolio")');
  await page.fill('input[placeholder="Portfolio Title"]', 'Test Portfolio');
  await page.fill('textarea[placeholder="Description"]', 'Test portfolio description');
  await page.click('button:has-text("Create")');
  await page.waitForNavigation();
  return page.url();
}

// ==================== USER JOURNEY TESTS ====================

test.describe('Complete User Journey', () => {

  test('User can sign up and create portfolio', async ({ page }) => {
    // Step 1: Visit landing page
    await page.goto(BASE_URL);
    expect(page).toHaveURL(BASE_URL);

    // Step 2: Click sign up
    await page.click('a:has-text("Sign Up")');
    await page.waitForNavigation();
    expect(page).toHaveURL(/\/auth\/signup/);

    // Step 3: Fill signup form
    await page.fill('input[type="email"]', TEST_USER.email);
    await page.fill('input[type="password"]', TEST_USER.password);
    await page.fill('input[placeholder="Full Name"]', TEST_USER.name);

    // Step 4: Submit signup
    await page.click('button:has-text("Create Account")');
    await page.waitForNavigation();

    // Step 5: Should be on dashboard
    expect(page).toHaveURL(/\/dashboard/);
  });

  test('User can create and design portfolio', async ({ page }) => {
    // Login
    await login(page);

    // Create portfolio
    const portfolioUrl = await createPortfolio(page);
    expect(portfolioUrl).toContain('/editor/');

    // Add content
    await page.click('button:has-text("Add Section")');
    await page.fill('input[placeholder="Section Title"]', 'Featured Project');
    await page.click('button:has-text("Save")');

    // Verify content saved
    const savedTitle = await page.textContent('h2');
    expect(savedTitle).toContain('Featured Project');
  });

  test('User can export portfolio to PDF', async ({ page, context }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    // Navigate to portfolio
    await page.goto(portfolioUrl);

    // Click export button
    await page.click('button:has-text("Export")');
    await page.click('button:has-text("PDF")');

    // Wait for download
    const downloadPromise = context.waitForEvent('download');
    await page.click('button:has-text("Download")');
    const download = await downloadPromise;

    expect(download.suggestedFilename()).toMatch(/\.pdf$/);
  });

  test('User can publish and share portfolio', async ({ page }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    // Navigate to portfolio
    await page.goto(portfolioUrl);

    // Open share modal
    await page.click('button:has-text("Share")');
    await expect(page.locator('text=Share Your Portfolio')).toBeVisible();

    // Get public link
    const linkInput = await page.inputValue('input[readonly]');
    expect(linkInput).toContain('cosmofolio.com');

    // Copy link
    await page.click('button:has-text("Copy")');
    expect(await page.textContent('button:has-text("Copy")')).toContain('Copied');
  });

  test('User can view social media previews', async ({ page }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    // Navigate to portfolio
    await page.goto(portfolioUrl);

    // Open share modal
    await page.click('button:has-text("Share")');

    // Click social tab
    await page.click('button:has-text("Social")');

    // Check social platforms
    expect(await page.isVisible('button:has-text("LinkedIn")')).toBeTruthy();
    expect(await page.isVisible('button:has-text("Twitter")')).toBeTruthy();
    expect(await page.isVisible('button:has-text("Facebook")')).toBeTruthy();
  });

});

// ==================== PORTFOLIO PREVIEW TESTS ====================

test.describe('Portfolio Preview', () => {

  test('Preview component renders correctly', async ({ page }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    // Navigate to portfolio
    await page.goto(portfolioUrl);

    // Check preview is visible
    const previewFrame = await page.frameLocator('iframe[title="Portfolio Preview"]');
    expect(previewFrame).toBeTruthy();
  });

  test('Can switch between device viewports', async ({ page }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    await page.goto(portfolioUrl);

    // Click mobile viewport
    await page.click('button:has-text("Mobile")');
    expect(page.locator('.viewport-mobile')).toBeVisible();

    // Click tablet viewport
    await page.click('button:has-text("Tablet")');
    expect(page.locator('.viewport-tablet')).toBeVisible();

    // Click desktop viewport
    await page.click('button:has-text("Desktop")');
    expect(page.locator('.viewport-desktop')).toBeVisible();
  });

  test('Can change style pack', async ({ page }) => {
    await login(page);
    const portfolioUrl = await createPortfolio(page);

    await page.goto(portfolioUrl);

    // Open style selector
    await page.click('select[aria-label="Style Pack"]');

    // Select dark_studio
    await page.click('option[value="dark_studio"]');

    // Verify change applied
    const selectedValue = await page.inputValue('select[aria-label="Style Pack"]');
    expect(selectedValue).toBe('dark_studio');
  });

});

